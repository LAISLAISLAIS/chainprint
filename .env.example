# =============================================================================
# Chainprint — copy to .env for `netlify dev`, and set the same keys in Netlify UI
# =============================================================================

# --- Core / site ---
# Canonical public origin (no trailing slash). Used for Stripe success/cancel URLs.
SITE_URL=http://localhost:8888

# Comma-separated browser origins allowed to call authenticated APIs (shares, stripe).
# Production: https://chainprint.app (and www if used). Local: include http://localhost:8888
CORS_ORIGINS=http://localhost:8888,http://localhost:3000

# --- Supabase (Project Settings → API) ---
# Anon/publishable key is safe in the browser WITH RLS. Service role is server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Required for Stripe webhooks / plan writes. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional aliases some hosts use:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Private beta site gate (netlify/edge-functions/site-gate.js) ---
# Required in production. No default password is shipped.
SITE_PASSWORD=
# HMAC signing secret for the gate cookie (long random string). Falls back to SITE_PASSWORD if unset.
SITE_GATE_SIGNING_SECRET=
# Set to "0" or "false" to disable the edge gate entirely (public launch).
# SITE_GATE_ENABLED=1

# --- Stripe (Billing → Developers) ---
# Use sk_test_… locally / deploy previews; sk_live_… only on production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for Pro (subscription). Dashboard → Product → Price → price_…
STRIPE_PRICE_PRO=
# Optional yearly price
# STRIPE_PRICE_PRO_YEARLY=
# Days of access while invoice is past_due (default 7)
SUBSCRIPTION_GRACE_DAYS=7

# --- Resend (product emails: welcome + Pro confirmation) ---
# Auth reset/confirm still use Supabase SMTP. These Netlify keys send welcome/Pro mail.
RESEND_API_KEY=
# Optional override (default: Chainprint <noreply@mail.chainprint.app>)
# EMAIL_FROM=Chainprint <noreply@mail.chainprint.app>

# --- Rate limiting (required in Netlify production) ---
# Create a free Redis DB at https://upstash.com → REST API
# If unset locally, an in-memory limiter is used. If unset in production CONTEXT, sensitive routes 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Proxies ---
# SoundCloud public client id (or leave empty to scrape/refresh). Prefer env over source defaults.
SOUNDCLOUD_CLIENT_ID=

# --- Dev unlocks (never enable in production) ---
# When "1", free tier behaves like Pro in the browser. Netlify CONTEXT=production forces this off.
CHAINPRINT_DEV_UNLOCK=

# --- Optional OAuth (Supabase Auth providers) ---
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
